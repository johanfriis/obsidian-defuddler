    <string name="no_obsidian">Obsidian isn\'t installed, so there\'s nowhere to save this.</string>
    <string name="save_failed">Couldn\'t hand the note to Obsidian. Nothing was saved.</string>

    <string name="reader_failed">The reader couldn\'t render this page.</string>
    <string name="load_failed_title">Couldn\'t load the page</string>


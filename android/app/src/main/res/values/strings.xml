    <!-- The app's name, on the launcher and on the home screen. Johan, 2026-09-03: the "(dev)"
         suffix was a placeholder from P0.6 and came from this string alone — there is no debug
         `applicationIdSuffix` or `resValue` behind it. Naming it after Obsidian is D34's territory
         (personal use, never distributed); the icon half of G2 is still open. -->
    <string name="app_name">Obsidian Reader</string>

    <string name="home_hint">Share a link from any app to read it here.</string>

    <string name="share_no_url">No link found in what was shared.</string>

    <!-- Shell controls: one FAB that opens a two-item menu (D25, reshaped by D33 and D35).
         Reload retired — toggling the reader off already reloads, which is D26's recovery. -->
    <string name="action_actions">Actions</string>
    <string name="action_close_menu">Close menu</string>
    <string name="action_reader">Reader</string>
    <string name="action_retry">Retry</string>
    <string name="action_clip">Clip</string>
    <string name="action_settings">Settings and templates</string>


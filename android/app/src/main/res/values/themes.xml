<resources>
    <!-- Light half of the day/night pair; values-night/themes.xml is the other.
         `isLightTheme` is stated explicitly because it is not only decoration: WebView reads it to
         decide whether a page may be shown in dark, so getting it wrong leaves the reader light on
         a dark system (which is exactly what happened before M1.8). -->
    <style name="Theme.ClipperDev" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
    </style>

    <!-- ShareReceiverActivity has no UI; it must not flash a window on the way to the reader. -->
    <style name="Theme.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>

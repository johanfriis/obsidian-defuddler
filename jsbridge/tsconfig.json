{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // Off only because the vendored submodule (a build input, not our code) has implicit anys.
    // Everything else strict still applies to test/, shim/ and src/.
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["test", "src", "shim", "build.mjs"]
}
